{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.0.2",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://makerworld.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MakerPulse"
  },
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://makerworld.com/*"
      ],
      "js": [
        "replies.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "MakerPulse",
  "background": {
    "service_worker": "background.js"
  }
}